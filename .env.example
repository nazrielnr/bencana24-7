# OpenAI-compatible provider settings (OpenRouter).
OPENAI_COMPAT_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_COMPAT_API_KEY="YOUR_OPENROUTER_API_KEY"

# Optional metadata headers recommended by OpenRouter.
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="siaga"

# Default chat model.
AI_MODEL="stepfun/step-3.5-flash:free"

# Optional frontend API base URL for static hosting on Vercel.
# Example: https://your-worker.your-subdomain.workers.dev
VITE_API_BASE_URL=""
