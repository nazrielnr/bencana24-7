{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "siaga-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-17",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "AI_MODEL": "gemini/gemini-2.0-flash-lite",
    "OPENAI_COMPAT_BASE_URL": "https://ai.sumopod.com",
    "OPENROUTER_SITE_URL": "https://siaga-app.anonymousblack987.workers.dev",
    "OPENROUTER_APP_NAME": "siaga",
    "OPENAI_COMPAT_API_KEY": "sk-NNGAl_WK2D-_wH3dE32Knw"
  }
}